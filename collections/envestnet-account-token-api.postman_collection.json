          "name": "Envestnet Create Account Token",
          "request": {
            "name": "Envestnet Create Account Token",
            "description": {
              "content": "The create account token service allows you to create a secure <code>processorToken</code> for a user's verified financial account. This <code>processorToken</code> can then be shared with one of our payment processor partners.",
              "type": "text/plain"
            },
            "url": {
